# ==============================================================================
# ClientFollow Environment Configuration
# ==============================================================================

# App Core & Security
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
# In production, SESSION_SECRET must be at least 32 characters long
SESSION_SECRET="your-at-least-32-characters-secure-random-session-secret"

# Supabase (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AWS KMS (Envelope Encryption - NIST SP 800-57 Compliant)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
KMS_MASTER_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/your-key-uuid"

# Inngest (Durable Event Workflows)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# Google Cloud (Gmail OAuth & Pub/Sub)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/gmail/callback"
GOOGLE_PUBSUB_TOPIC="projects/your-project/topics/gmail-inbox-watch"

# Meta WhatsApp Business Cloud API
WHATSAPP_API_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-business-account-id"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-custom-verify-token"
WHATSAPP_APP_SECRET="your-meta-app-secret-for-hmac-verification"

# AI Intelligence (Classifier) - Choose Local (Ollama/LM Studio) or Cloud (OpenAI)
# Option A: Local LLM with Ollama (Zero cost, no API key needed):
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_MODEL="llama3.2"  # or "qwen2.5", "mistral", "phi4"
#
# Option B: Cloud OpenAI:
OPENAI_API_KEY="your-openai-api-key"
# OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Stripe Billing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STARTER="price_starter_19"
STRIPE_PRICE_GROWTH="price_growth_49"
STRIPE_PRICE_PRO="price_pro_99"
